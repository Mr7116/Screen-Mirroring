{
  "name": "mirrordesk",
  "productName": "MirrorDesk",
  "version": "1.0.0",
  "description": "Screen mirroring and remote control receiver for Android phones and browser senders",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build": "node scripts/check.js",
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.7116.mirrordesk.desktop",
    "productName": "MirrorDesk",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "ios-sender/MirrorSender/Assets.xcassets/AppIcon.appiconset/AppIcon.png",
      "artifactName": "MirrorDesk-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
